<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sarax_impedance_controller</name>
  <version>0.1.0</version>
  <description>
    Joint-space impedance controller for ros2_control, with a pluginlib-based
    ImpedanceLaw abstraction so new control laws can be added in downstream packages
    without modifying this one.
  </description>
  <maintainer email="a.n.alharbat@gmail.com">Ayham</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>controller_interface</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>realtime_tools</depend>
  <depend>trajectory_msgs</depend>
  <depend>std_msgs</depend>
  <depend>eigen</depend>
  <depend>pinocchio</depend>
  <depend>sarax_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <!-- The controller plugin (loaded by controller_manager). -->
    <controller_interface plugin="${prefix}/sarax_controllers.xml"/>
    <!-- The ImpedanceLaw plugins shipped by this package. -->
    <sarax_impedance_controller plugin="${prefix}/sarax_impedance_laws.xml"/>
  </export>
</package>
