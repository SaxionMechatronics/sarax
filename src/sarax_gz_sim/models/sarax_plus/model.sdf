      <motorType>velocity</motorType>
    </plugin>

    <!-- Publish joint states on /world/<world>/model/sarax_plus/joint_state
         (gz topic). Bridge to ROS 2 later with:
           ros2 run ros_gz_bridge parameter_bridge \
             /world/default/model/sarax_plus/joint_state@sensor_msgs/msg/JointState[gz.msgs.Model
         Only the manipulator joints are listed so rotor velocities don't
         swamp the topic. -->
    <!-- ros2_control integration via gz_ros2_control. This replaces the
         ApplyJointForce + JointStatePublisher plugins: the controller_manager
         spawned inside Gazebo exposes effort command + position/velocity state
         interfaces for mani_joint_1 and mani_joint_2 natively on the ROS 2 bus.
         Controllers are loaded from the YAML shipped by sarax_bringup. Update
         the absolute path below if you relocate the workspace. -->
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>/home/ayham/wspaces/sarax_ws/install/sarax_bringup/share/sarax_bringup/config/controllers.yaml</parameters>
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <ros>
        <namespace>/</namespace>
      </ros>
    </plugin>

  </model>
</sdf>
