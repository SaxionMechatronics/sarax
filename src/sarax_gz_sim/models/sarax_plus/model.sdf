<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='sarax_plus'>
    <pose>0 0 0.2 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>

    <link name='base_link'>
      <inertial>
        <mass>9.5</mass>
        <inertia>
          <ixx>0.2</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.2</iyy>
          <iyz>0</iyz>
          <izz>0.3</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>
      <velocity_decay/>
      <visual name='base_link_visual'>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://sarax_plus/meshes/sarax-base.stl</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.9 0.9 0.9 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <collision name='base_link_collision'>
        <pose>0 0 -0.05 0 0 0</pose>
        <geometry>
          <box>
            <size>0.46 0.46 0.26</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <sensor name="air_pressure_sensor" type="air_pressure">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>3</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>
      <sensor name="magnetometer_sensor" type="magnetometer">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <x>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </z>
        </magnetometer>
      </sensor>
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0008726646</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0008726646</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0008726646</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.00637</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.00637</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.00686</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>
    </link>

    <!-- ===== 2-DOF manipulator ===== -->
    <!-- Links and joints copied from the SaraX source. Revolute joints are
         unactuated here — they will droop under gravity until a controller is
         wired up. Joint states are published by the JointStatePublisher
         plugin at the bottom of this file. To drive the joints via ROS 2 /
         ros2_control later, add a gz_ros2_control-system plugin referencing
         a URDF whose <ros2_control> block declares the same joint names
         (mani_joint_1, mani_joint_2). -->

    <link name='link1'>
      <pose relative_to='base_link'>0 0 0.002 1.5708 0 0</pose>
      <inertial>
        <mass>0.141134</mass>
        <inertia>
          <ixx>0.0001747</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0003488</iyy><iyz>0</iyz>
          <izz>0.0001747</izz>
        </inertia>
      </inertial>
      <visual name='link1_visual'>
        <geometry>
          <mesh><scale>1 1 1</scale><uri>model://sarax_plus/meshes/link1.dae</uri></mesh>
        </geometry>
        <material><diffuse>1.0 0.5 0.1 1</diffuse></material>
      </visual>
    </link>
    <joint name='ar_mani_fixed' type='fixed'>
      <parent>base_link</parent>
      <child>link1</child>
    </joint>

    <link name='link2'>
      <pose relative_to='mani_fixed'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0.0014 0 0 0 0</pose>
        <mass>1.06637</mass>
        <inertia>
          <ixx>0.001663</ixx><ixy>-2.18382e-05</ixy><ixz>-2.18382e-05</ixz>
          <iyy>0.001855</iyy><iyz>-3.62233e-06</iyz>
          <izz>0.002551</izz>
        </inertia>
      </inertial>
      <visual name='link2_visual'>
        <geometry>
          <mesh><scale>1 1 1</scale><uri>model://sarax_plus/meshes/link2.dae</uri></mesh>
        </geometry>
      </visual>
    </link>
    <joint name='mani_fixed' type='fixed'>
      <pose relative_to='link1'>0 0.003 0 0 1.5708 0</pose>
      <parent>link1</parent>
      <child>link2</child>
    </joint>

    <link name='link3'>
      <pose relative_to='mani_joint_1'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0.2587 0 0 0 0</pose>
        <mass>0.363477</mass>
        <inertia>
          <ixx>0.01032</ixx><ixy>-0.0001221</ixy><ixz>0</ixz>
          <iyy>0.000222</iyy><iyz>0</iyz>
          <izz>0.01038</izz>
        </inertia>
      </inertial>
      <visual name='link3_visual'>
        <geometry>
          <mesh><scale>1 1 1</scale><uri>model://sarax_plus/meshes/link3.dae</uri></mesh>
        </geometry>
      </visual>
    </link>
    <joint name='mani_joint_1' type='revolute'>
      <pose relative_to='link2'>0 0.075 0 0 0 0</pose>
      <parent>link2</parent>
      <child>link3</child>
      <axis>
        <xyz>-1 0 0</xyz>
        <limit>
          <lower>-1.5708</lower>
          <upper>1.5708</upper>
          <effort>30</effort>
          <velocity>3.14</velocity>
        </limit>
        <dynamics>
          <damping>0.7</damping>
          <friction>0</friction>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <link name='link4'>
      <pose relative_to='mani_joint_2'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0.2 0 0 0 0</pose>
        <mass>0.113791</mass>
        <inertia>
          <ixx>0.003351</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.003336</iyy><iyz>0</iyz>
          <izz>3.30137e-05</izz>
        </inertia>
      </inertial>
      <collision name='link4_collision'>
        <pose>0 0.2 0 0 0 0</pose>
        <geometry>
          <box><size>0.025 0.48 0.03</size></box>
        </geometry>
      </collision>
      <visual name='link4_visual'>
        <geometry>
          <mesh><scale>1 1 1</scale><uri>model://sarax_plus/meshes/link4.dae</uri></mesh>
        </geometry>
      </visual>
    </link>
    <joint name='mani_joint_2' type='revolute'>
      <pose relative_to='link3'>0 0.4 0 0 0 0</pose>
      <parent>link3</parent>
      <child>link4</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-2.6</lower>
          <upper>2.6</upper>
          <effort>30</effort>
          <velocity>3.14</velocity>
        </limit>
        <dynamics>
          <damping>0.7</damping>
          <friction>0</friction>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <!-- ===== end manipulator ===== -->

    <!-- Rotor positions (SDF z-up): top at z=+0.045, bottom at z=-0.045 -->
    <!-- motorNumber convention:
         0: top  ( 0.3181, -0.3181)  CCW
         1: top  ( 0.3181,  0.3181)  CW
         2: top  (-0.3181,  0.3181)  CCW
         3: top  (-0.3181, -0.3181)  CW
         4: bot  ( 0.3181,  0.3181)  CCW
         5: bot  ( 0.3181, -0.3181)  CW
         6: bot  (-0.3181, -0.3181)  CCW
         7: bot  (-0.3181,  0.3181)  CW
    -->

    <link name='rotor_0'>
      <pose>0.3181 -0.3181 0.045 0 0 0</pose>
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <inertial>
        <mass>0.005</mass>
        <inertia>
          <ixx>9.75e-07</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000273104</iyy><iyz>0</iyz>
          <izz>0.000274004</izz>
        </inertia>
      </inertial>
      <visual name='rotor_0_visual'>
        <geometry>
          <mesh><scale>1 1 1</scale><uri>model://sarax_plus/meshes/iris_prop_ccw.dae</uri></mesh>
        </geometry>
        <material><diffuse>0.1 0.3 0.8 1</diffuse></material>
      </visual>
    </link>
    <joint name='rotor_0_joint' type='revolute'>
      <parent>base_link</parent>
      <child>rotor_0</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics>
      </axis>
    </joint>

    <link name='rotor_1'>
      <pose>0.3181 0.3181 0.045 0 0 0</pose>
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <inertial>
        <mass>0.005</mass>
        <inertia>
          <ixx>9.75e-07</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000273104</iyy><iyz>0</iyz>
          <izz>0.000274004</izz>
        </inertia>
      </inertial>
      <visual name='rotor_1_visual'>
        <geometry>
          <mesh><scale>1 1 1</scale><uri>model://sarax_plus/meshes/iris_prop_cw.dae</uri></mesh>
        </geometry>
        <material><diffuse>0.1 0.3 0.8 1</diffuse></material>
      </visual>
    </link>
    <joint name='rotor_1_joint' type='revolute'>
      <parent>base_link</parent>
      <child>rotor_1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
