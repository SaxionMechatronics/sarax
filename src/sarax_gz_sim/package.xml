<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sarax_gz_sim</name>
  <version>0.1.0</version>
  <description>Gazebo model + world assets for SARAX+, with gz_ros2_control wiring
  for the manipulator. Source copy mirrored to PX4-Autopilot/Tools/simulation/gz/models.</description>
  <maintainer email="a.alharbat@saxion.nl">Ayham</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
