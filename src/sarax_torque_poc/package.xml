<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sarax_torque_poc</name>
  <version>0.1.0</version>
  <description>
    Proof-of-concept publisher that sends arbitrary joint torques to the simulated
    SARAX+ 2-DoF manipulator via the Gazebo ApplyJointForce plugin, bridged to ROS 2.
  </description>
  <maintainer email="a.alharbat@saxion.nl">Ayham</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>

  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
